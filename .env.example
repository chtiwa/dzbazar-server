# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DB_URI="postgresql://user:password@host:5432/dbname"

# Secret used to sign/verify JWT access + refresh tokens
JWT_SECRET="change-me"

# dev | production — gates secure cookie flags and other environment-specific behavior
APP_ENV=dev

# Resend (transactional email)
RESEND_API_KEY=

# Frontend origins allowed by CORS
CLIENT_URL="http://localhost:5173"
CLIENT_URL_V2="http://localhost:5174"
ADMIN_URL="http://localhost:5173"
SUPER_ADMIN_URL="http://localhost:5175"

# Backblaze B2 (S3-compatible) image storage
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_REGION=
# Optional — custom public CDN domain for served images; falls back to the
# standard B2 URL format if unset
B2_PUBLIC_BASE_URL=

# Redis (caching, rate limiting)
REDIS_URI="redis://default:password@host:port"

# TikTok Conversions API — REMOVED. TikTok CAPI now reads pixel ID + access
# token per-shop from the `pixels` table (platform="tiktok"), same as
# Facebook, instead of one global pixel/token for the whole platform. These
# two env vars are no longer read anywhere; delete them from your .env.

# Facebook CAPI test event code — dev/staging only, omit in production
FACEBOOK_TEST_CODE=

# ipinfo.io API token (privacy endpoint — vpn/proxy/hosting detection for the
# shop-level VPN/datacenter fraud-signal toggles). Unset = those two signals
# are silently disabled (fail open), incognito detection is unaffected.
IPINFO_TOKEN=

# 32-byte AES-256 key, base64 std-encoding (generate with `openssl rand -base64 32`).
# Encrypts at rest: Pixel.AccessToken, DeliveryCompany.Token/MerchantID (Meta/
# TikTok/carrier API credentials). Required — reads/writes of these fields
# fail if unset or not exactly 32 bytes decoded.
FIELD_ENCRYPTION_KEY=

# AI proxy (OpenAI-compatible /chat/completions) — used to generate HTML
# product descriptions from a merchant's short input, and to answer questions
# in the admin help chat widget. Unset = the "Generate with AI" button and the
# help chat both return 503. Works with any OpenAI-compatible provider — e.g.
# OpenRouter (https://openrouter.ai/keys), model "google/gemini-2.5-flash" etc.
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=
AI_MODEL_NAME="google/gemini-2.5-flash"
# Image-capable model on the same proxy, used by the landing page
# "Generate with AI" image button. Unset = that button returns 503.
AI_IMAGE_MODEL_NAME="google/gemini-3-pro-image-preview"
